#ifndef OpenSoundAudioDriver_iig
#define OpenSoundAudioDriver_iig

#include <AudioDriverKit/IOUserAudioDevice.iig>

class OpenSoundAudioDriver: public IOUserAudioDevice
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;

    virtual kern_return_t StartIOProc(IOUserAudioIOProc* proc) override;
    virtual kern_return_t StopIOProc(IOUserAudioIOProc* proc) override;
};

#endif /* OpenSoundAudioDriver_iig */
